[Unit]
Description=CeraLive HDMI-RX — apply the product EDID to the capture receiver
Documentation=file:///usr/local/sbin/ceralive-hdmirx-edid
# The HDMI-RX driver ships with NO EDID and its own Kconfig says a product is
# expected to load a custom branded one from userspace — the receiver is
# deliberately not functional until something does. With no EDID an attached
# source sees nothing on the DDC lines and either falls back to its most
# conservative mode or refuses to output at all, which on a bench reads as
# "HDMI capture is broken". Full root cause + the applicability table:
# /usr/local/sbin/ceralive-hdmirx-edid header.
#
# The image ships TWO committed blobs and this unit programs exactly one of
# them, selected by `hdmirx.edid_profile` in /data/ceralive/hdmirx.conf:
#   full (the default) — 4K60 at 594 MHz with SCDC and a 600 MHz HF-VSDB rate,
#     the pair that makes 4K60 legal for a source to offer, plus a Y420CMDB.
#   robust-4k60        — an HDMI 1.4-class advertisement with no HF-VSDB and so
#     no SCDC, 4K60 offered only as 4:2:0, preferred timing 4K30 at 297 MHz.
# An absent, unreadable, or unrecognised selector resolves to `full`, so a fresh
# or upgraded device behaves exactly as it did before profiles existed.
#
# systemd-udev-trigger is the coldplug that gets the hdmirx platform driver
# bound and the /dev/hdmirx symlink written; After= it is the earliest sensible
# point, but driver probe is ASYNCHRONOUS so it is NOT a guarantee that the node
# exists yet. The script owns that race with a bounded poll rather than a sleep.
#
# data.mount carries /data/ceralive/hdmirx.conf, the one file that says WHICH of
# the two committed EDID profiles is active. Ordering after it is what stops a
# board that has selected `robust-4k60` from being programmed with `full`
# because the selector had not been mounted yet.
#
# ORDERING-ONLY, AND NEVER RequiresMountsFor=/data — that is the whole point of
# spelling the mount unit out by hand. RequiresMountsFor= adds Requires= as well
# as After=, so a board whose /data failed to mount would not merely lose its
# profile SELECTION, it would get NO EDID AT ALL and a dead receiver. The
# script's own resolution table already treats an unreachable config as "use the
# default", which is strictly the better outcome. An After= onto a unit that
# does not exist is a no-op, so this is equally safe on a board with no /data.
After=systemd-udev-trigger.service data.mount
# cerastream is what actually opens the capture device, and ceralive.service
# (CeraUI) connects to cerastream's control socket exactly once at boot. Both
# must see a receiver whose EDID is already programmed. Ordering-only: neither
# is required to exist, and After=/Before= against an out-of-transaction unit is
# a no-op, so this is safe on boards and slots where cerastream is absent.
Before=cerastream.service ceralive.service
#
# THIS UNIT IS DELIBERATELY NOT A DEPENDENCY OF cerastream, IN EITHER DIRECTION.
# There is no Requires=/Wants=/BindsTo= here onto cerastream, and nothing may
# add one from cerastream's side onto this unit. A failed EDID apply MUST be
# loudly visible in `systemctl status` / `systemctl --failed` — that is the
# whole point of failing rather than no-opping — but it MUST NOT keep the
# streaming stack down: USB/UVC capture does not involve the HDMI receiver at
# all, so a board with a dead HDMI-RX must still boot into a fully usable
# USB-capture-only device. Ordering without a requirement is exactly that
# contract, and it mirrors ceralive-typec-policy.service.
#
# LIFECYCLE: boot-time only. The EDID lives in driver state, so a driver
# unbind/rebind or a module reload silently discards it and this unit does NOT
# notice and does NOT reapply. Known limitation, not a bug — after a bench
# rebind, run `systemctl restart ceralive-hdmirx-edid.service` explicitly. The
# same restart is how a changed profile is applied.
#
# NEVER MID-STREAM. VIDIOC_S_EDID drops HPD, writes, and raises HPD again, which
# under a live capture is a source-side mode renegotiation in the middle of a
# broadcast. The kernel enforces this — the HDMI-RX driver answers -EBUSY while
# the node is streaming — and the script HONOURS that answer: it refuses without
# retrying and without forcing, and exits non-zero so the refusal is visible
# rather than reading as an applied EDID. Boot is safe by construction because
# nothing has opened the capture device yet.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ceralive-hdmirx-edid
# Must exceed the script's own 30s poll deadline plus its two bounded apply
# attempts, so systemd never kills it mid-wait and turns a slow hdmirx probe
# into a unit failure that looks like a driver defect.
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
