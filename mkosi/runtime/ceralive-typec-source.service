[Unit]
Description=CeraLive USB-C connector — pin the Type-C port to the source role
Documentation=file:///usr/local/sbin/ceralive-typec-source
# The USB-C connector is a DRP (dual-role) port, so on every fresh boot its
# port_type comes up `[dual] source sink` and the CC state machine has to settle
# the role by Try.SRC/Try.SNK arbitration with the attached device. Against a
# dual-role camera that arbitration genuinely races (TCPM log: repeated
# `SNK_TRY_WAIT -> SRC_TRYWAIT`), and when it lands on sink the SoC's own DWC3
# runs as a peripheral — the camera's USB bus never appears at all. Pinning the
# port to source removes the arbitration and the camera enumerates every time.
# Full root cause + evidence: /usr/local/sbin/ceralive-typec-source header.
#
# systemd-udev-trigger is the coldplug that gets the fusb302/TCPM driver bound;
# After= it is the earliest sensible point, but driver probe is ASYNCHRONOUS so
# it is NOT a guarantee that /sys/class/typec/port0 exists yet. The script owns
# that race with a bounded poll rather than a fixed sleep.
After=systemd-udev-trigger.service
# cerastream is what actually opens the capture device, and ceralive.service
# (CeraUI) connects to cerastream's control socket exactly once at boot. Both
# must see a port that is already pinned. Ordering-only — neither is required to
# exist, and After=/Before= against an out-of-transaction unit is a no-op, so
# this is safe on boards and slots where cerastream is absent.
Before=cerastream.service ceralive.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ceralive-typec-source
# Must exceed the script's own 30s poll deadline so systemd never kills it
# mid-wait and turns a slow TCPM probe into a unit failure.
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
