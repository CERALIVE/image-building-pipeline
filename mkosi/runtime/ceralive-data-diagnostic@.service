[Unit]
Description=Read-only startup status connection
PartOf=ceralive-attention.service ceralive-data-diagnostic.socket

[Service]
ExecStart=/usr/libexec/ceralive/ceralive-data-diagnostic serve
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=5s
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
