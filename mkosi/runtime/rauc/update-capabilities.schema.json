{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "features", "ota_uid", "apt_uid"],
  "properties": {
    "schema": { "const": 1 },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "rauc-verity-streaming",
          "rauc-activate-on-shutdown",
          "slot-sync",
          "origin-protection",
          "apt-all-packages",
          "reprune-hook",
          "apt-credentials",
          "transport-uidrange"
        ]
      }
    },
    "ota_uid": { "type": "integer", "minimum": 1 },
    "apt_uid": { "type": "integer", "minimum": 1 }
  }
}
