[Unit]
Description=Device-bound browser front door
Requires=ceralive-button-backend-fence.service ceralive-tls-firstboot.service
Wants=ceralive.service
After=network.target ceralive-button-backend-fence.service ceralive-tls-firstboot.service ceralive.service
Conflicts=nginx.service
PartOf=ceralive-tls-firstboot.service

[Service]
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/lib/ceralive-button-ingress/ingress.py
Restart=on-failure
RestartSec=2
UMask=0077
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LimitNOFILE=1024
MemoryMax=128M
TasksMax=16

[Install]
WantedBy=multi-user.target
