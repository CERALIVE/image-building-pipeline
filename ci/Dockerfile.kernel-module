# Reproducible cross-builder for the one production-vendor kernel extension.
# Ubuntu 24.04 carries GCC 13, matching the compiler recorded by Armbian's
# linux-headers-vendor-rk35xx 26.5.1 package.
FROM ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      make gcc gcc-aarch64-linux-gnu libc6-dev bison flex \
      libssl-dev libelf-dev dwarves kmod dpkg-dev xz-utils zstd \
 && rm -rf /var/lib/apt/lists/*

COPY lib/kernel/build-cls-fw-container.sh /usr/local/bin/build-cls-fw-container
RUN chmod 0755 /usr/local/bin/build-cls-fw-container \
 && aarch64-linux-gnu-gcc --version \
 && modinfo --version

ENTRYPOINT ["/usr/local/bin/build-cls-fw-container"]
