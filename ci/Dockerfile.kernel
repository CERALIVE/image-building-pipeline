# CeraLive v2 — kernel-build-from-source container (Task 26).
#
# Used ONLY by lib/build-kernel.sh, which runs `make bindeb-pkg` inside this
# image for any resolve that declares a `kernel_source:` block — on rk3588 that
# is every build, `edge` being the production default_variant. A prebuilt-BSP
# family (x86-minipc) never builds this image and never runs this stage.
#
# THE BASE IMAGE IS NOT PINNED HERE. BASE_IMAGE is REQUIRED and is supplied by
# lib/build-kernel.sh from the manifest's kernel_source.builder_image, which the
# schema constrains to a repo:tag@sha256:<digest> form. Keeping the pin in the
# manifest — not in this file — means the builder digest is reviewed alongside
# the kernel and patch pins it is paired with, in one place, instead of drifting
# in a Dockerfile default nobody reads. The build FAILS if BASE_IMAGE is unset.
#
# WHY a container at all: the host may be any distro (this repo is developed on
# Arch), and a kernel build is exquisitely sensitive to toolchain version. One
# digest-pinned Debian trixie image gives the same gcc/binutils/dpkg-dev
# everywhere, which is the only way `make bindeb-pkg` output is comparable
# across machines.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# OPT-IN apt proxy — same contract as ci/Dockerfile: http only, unset by default,
# and confined to the single RUN that uses it so no host-local proxy URL (which
# may carry credentials) survives into a shared builder layer.
ARG APT_PROXY=

ENV DEBIAN_FRONTEND=noninteractive \
    CCACHE_DIR=/ccache \
    PATH=/usr/lib/ccache:$PATH

# Kernel build closure, in the order `make bindeb-pkg` needs them:
#   build-essential bc bison flex   kbuild + Kconfig parser
#   libssl-dev libelf-dev libdw-dev module signing + objtool/BTF
#   dwarves                         pahole, the DWARF->BTF converter
#   gcc-aarch64-linux-gnu           the arm64 cross toolchain (RK3588 target)
#   dpkg-dev debhelper fakeroot     bindeb-pkg's Debian packaging path
#   kmod cpio rsync zstd xz-utils   depmod, initramfs plumbing, deb compression
#   git ca-certificates             pinned source + patch-series checkout
#   ccache                          the reason a rebuild is minutes not hours
#
# arm64 is enabled as a FOREIGN dpkg architecture because `bindeb-pkg` runs
# dpkg-buildpackage with `-a arm64`, which pulls in two arm64-side requirements
# the plain cross toolchain does not carry:
#
#   libssl-dev:arm64  the generated Build-Depends-Arch asks for BOTH
#                     `libssl-dev:native` (amd64) and an unqualified `libssl-dev`,
#                     which resolves to the arm64 HOST arch. Missing it aborts
#                     dpkg-checkbuilddeps before a single object is compiled.
#   libc6-dev:arm64   scripts/package/install-extmod-build rebuilds the kernel's
#                     host programs with HOSTCC set to the CROSS gcc, so they run
#                     on the target. Debian's cross gcc resolves its libc through
#                     the multiarch path /usr/include/aarch64-linux-gnu, which
#                     only this package provides — `gcc-aarch64-linux-gnu` alone
#                     ships no target libc. The kernel proper is freestanding and
#                     builds without it; the linux-headers package does not.
#
# libdw-dev is an unconditional `:native` build-dep of the same generated control.
#
# dwarves (pahole) is required by any config carrying CONFIG_DEBUG_INFO_BTF, which
# nothing in this repo declares either way — it is inherited from whatever base
# config a track starts from. Its absence is NOT a build error: `DEBUG_INFO_BTF`
# is gated on `PAHOLE_VERSION >= 121`, so kconfig would silently DROP the symbol
# and ship a kernel with no BTF, which is exactly the class of silent config loss
# lib/verify-kernel-config.sh exists to catch. Installing the tool is the fix; the
# gate is the proof.
#
# The cache mounts, the docker-clean move-aside and the ABSENCE of an
# `rm -rf /var/lib/apt/lists/*` are the same contract ci/Dockerfile documents at
# length; read it there. This closure is the expensive one — the arm64 foreign
# architecture roughly doubles the index fetch and the cross toolchain is the
# largest single download in the pipeline — so it is also the layer with the most
# to lose from a cache mount that silently retains nothing.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    set -eu; \
    [ -f /etc/apt/apt.conf.d/docker-clean ] \
      && mv /etc/apt/apt.conf.d/docker-clean /tmp/ceralive-docker-clean || true; \
    printf 'Binary::apt::APT::Keep-Downloaded-Packages "true";\n' \
      > /etc/apt/apt.conf.d/99ceralive-keep-cache; \
    if [ -n "${APT_PROXY}" ]; then \
      printf 'Acquire::http::Proxy "%s";\n' "${APT_PROXY}" \
        > /etc/apt/apt.conf.d/99ceralive-proxy; \
    fi; \
    mkdir -p /var/cache/apt/archives/partial /var/lib/apt/lists/partial; \
    dpkg --add-architecture arm64; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      -o Dpkg::Options::=--force-unsafe-io \
      build-essential \
      bc \
      bison \
      flex \
      libssl-dev \
      libssl-dev:arm64 \
      libelf-dev \
      libdw-dev \
      dwarves \
      gcc-aarch64-linux-gnu \
      libc6-dev:arm64 \
      dpkg-dev \
      debhelper \
      fakeroot \
      kmod \
      cpio \
      rsync \
      zstd \
      xz-utils \
      git \
      ca-certificates \
      python3 \
      ccache; \
    rm -f /etc/apt/apt.conf.d/99ceralive-proxy /etc/apt/apt.conf.d/99ceralive-keep-cache; \
    [ -f /tmp/ceralive-docker-clean ] \
      && mv /tmp/ceralive-docker-clean /etc/apt/apt.conf.d/docker-clean || true

# ccache wrappers for the cross compiler. /usr/lib/ccache is first on PATH, so a
# plain `aarch64-linux-gnu-gcc` invocation from kbuild is cached without the
# Makefile having to know ccache exists.
RUN ccache --version \
 && ln -sf /usr/bin/ccache /usr/lib/ccache/aarch64-linux-gnu-gcc \
 && ln -sf /usr/bin/ccache /usr/lib/ccache/aarch64-linux-gnu-g++

# Fail the image build LOUDLY if the cross toolchain is not what we asked for.
RUN aarch64-linux-gnu-gcc --version \
 && pahole --version \
 && dpkg-architecture -aarm64 -qDEB_HOST_ARCH
