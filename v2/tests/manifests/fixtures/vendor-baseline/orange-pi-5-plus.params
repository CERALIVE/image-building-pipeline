APP_BACKEND='sysext'
ARCH='arm64'
ARMBIAN_BRANCH='vendor'
ARMBIAN_OVERLAYS='rk3588-hdmi-input rk3588-wifi-rtl8821cs rk3588-m2-nvme'
BOARD_ID='orangepi5-plus'
DESCRIPTION='Orange Pi 5+ (RK3588S). Best choice for HDMI-input setups (BELABOX-recommended); HDMI capture less affected by EMI. Full 4K@60fps capture/encode. M.2 2280 M-key slot for NVMe. Onboard RTL8821CS Wi-Fi, 3.7 A USB power budget — powers most USB modems without a hub. eMMC/NVMe/microSD targets (16 GB+).'
DTB_NAME='rk3588s-orangepi-5-plus.dtb'
DTB_PACKAGES='linux-dtb-vendor-rk35xx'
FAMILY='rk3588'
FIRMWARE_PACKAGES='armbian-firmware libmali-valhall-g610-g24p0-wayland-gbm'
GSTREAMER_RUNTIME_PACKAGES='rockchip-multimedia-config librga2 librockchip-mpp1 librockchip-mpp-dev'
HW_ACCEL_GSTREAMER_PLUGINS='gstreamer1.0-rockchip1'
INTERFACES_ETH0='FIXME-read-from-udevadm-info-on-opi5plus-primary-port'
INTERFACES_ETH1='FIXME-read-from-udevadm-info-on-opi5plus-secondary-port'
INTERFACES_WLAN0='FIXME-read-from-udevadm-info-on-opi5plus-wifi'
KERNEL_PACKAGES='linux-image-vendor-rk35xx'
PARTITION_TEMPLATE='rk3588-ab'
RAUC_BOOTLOADER_ADAPTER='custom'
SERIAL_CONSOLE='ttyS2:1500000'
SINGLE_SLOT_FALLBACK='false'
UBOOT_PACKAGES='linux-u-boot-orangepi5-plus-vendor'
