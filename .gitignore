# Build artifacts emitted by lib/orchestrate.sh — never committed.
images/
# Per-board build logs emitted by lib/build-all.sh — runtime only, never committed.
logs/
*.img
*.img.xz
*.sha*
.DS_Store
build-logs/
*.log
cache/
secrets/
.env
.env.*
.vscode/
.idea/
*.deb
debs/
*.iso
*.swp
*~
Thumbs.db
.cursor/

# Non-production RAUC test keys are generated on demand and never committed.
.dev-keys/

# OpenCode agent state (local only)
.omo/

# Repo-local test/QA evidence (coverage, diffs, traces) — never committed
test-results/
test-results-*.txt

# BSP provenance — floating kernel BSP version+hash recorded per build into the
# image output dir. Build output, never committed, and deliberately excluded from
# the build-matrix sha256 determinism comparison (the float would break it).
bsp-provenance.json

# mkosi scratch workspace (--workspace-directory, lib/paths.sh). Pinned beside the
# output tree so finished subimages are renamed rather than copied across devices.
.mkosi-workspace/
.build-secrets/
