APP_BACKEND='sysext'
ARCH='arm64'
ARMBIAN_BRANCH='vendor'
ARMBIAN_OVERLAYS='rk3588-hdmi-input rk3588-wifi-rtl8852be rk3588-m2-modem-42mm rk3588-usb-power-delivery'
BOARD_ID='rock-5b-plus'
DESCRIPTION='Radxa Rock 5B+ (RK3588). Best HDMI-input EMI resistance (BELABOX-recommended); full-featured streaming appliance. M.2 B-key 42 mm slot for 4G/5G cellular modems (no 52 mm support) with a required SIM-detection workaround. Onboard RTL8852BE Wi-Fi, 5.45 A USB power budget. eMMC/NVMe/microSD targets (16 GB+).'
DTB_NAME='rk3588-rock-5b-plus.dtb'
DTB_PACKAGES='linux-dtb-vendor-rk35xx'
FAMILY='rk3588'
FIRMWARE_PACKAGES='armbian-firmware libmali-valhall-g610-g24p0-wayland-gbm'
GSTREAMER_RUNTIME_PACKAGES='rockchip-multimedia-config librga2 librockchip-mpp1 librockchip-mpp-dev'
HW_ACCEL_GSTREAMER_PLUGINS='gstreamer1.0-rockchip1'
INTERFACES_ETH0='platform-fe190000.pcie-pci-0004:41:00.0'
INTERFACES_WLAN0='platform-fe170000.pcie-pci-0002:21:00.0'
KERNEL_PACKAGES='linux-image-vendor-rk35xx'
MODEM_PORTS_STATUS='unverified'
PARTITION_TEMPLATE='rk3588-ab'
QUIRKS_HDMI_INPUT_EMI_SHIELD='true'
QUIRKS_M2_MODEM_SIM_WORKAROUND='required'
QUIRKS_USB_POWER_OPTIMIZATION='true'
RAUC_BOOTLOADER_ADAPTER='custom'
SERIAL_CONSOLE='ttyS2:1500000'
SINGLE_SLOT_FALLBACK='false'
UBOOT_PACKAGES='linux-u-boot-rock-5b-plus-vendor'
