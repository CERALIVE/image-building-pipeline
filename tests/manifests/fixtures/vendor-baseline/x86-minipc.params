APP_BACKEND='sysext'
ARCH='x86-64'
ARMBIAN_BRANCH='none'
BOARD_ID='x86-minipc'
DESCRIPTION='Generic x86_64 mini-PC (N100/N200 or similar). UEFI/GRUB boot with RAUC A/B on an EFI System Partition; Debian generic amd64 kernel (no Armbian BSP, no U-Boot, no device tree — ACPI enumeration). Full bonded streaming via Intel VAAPI/QSV hardware encode (Gen12 graphics) with x264 software fallback (decision D1). Assumes an internal NVMe/SATA SSD (>= 32 GB). No board-specific quirks or device-tree overlays — a stock x86 platform needs none.'
DTB_NAME='none'
DTB_PACKAGES=''
FAMILY='x86_64'
FIRMWARE_PACKAGES='firmware-linux-free firmware-linux-nonfree intel-microcode'
HW_ACCEL_GSTREAMER_PLUGINS='gstreamer1.0-vaapi intel-media-va-driver-non-free'
KERNEL_PACKAGES='linux-image-amd64'
PARTITION_TEMPLATE='x86-ab'
RAUC_BOOTLOADER_ADAPTER='efi'
SERIAL_CONSOLE='ttyS0:115200'
SINGLE_SLOT_FALLBACK='false'
UBOOT_PACKAGES=''
