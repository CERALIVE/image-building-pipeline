# CeraLive RK3588 `edge` kernel — Kconfig fragment
#
# Merged ON TOP of the in-tree arm64 `defconfig` by
# scripts/kconfig/merge_config.sh, from lib/build-kernel.sh. Referenced by
# manifests/families/rk3588.yaml -> variants.edge.kernel_source.defconfig_fragment.
#
# SCOPE: this fragment declares the symbols the CeraLive device stack needs that
# arm64 `defconfig` does not already imply, plus the two determinism switches.
# It is NOT a port of Armbian's linux-rockchip64-edge.config: that config is a
# full 10k-line file tuned for Armbian's own userspace and build framework, and
# copying it would silently import decisions nobody here reviewed. Starting from
# mainline defconfig and adding exactly what we need keeps every line auditable.
#
# PARTLY HARDWARE-PROVEN as of the v7.1.7 pin. A Rock 5B+ has booted an image
# built from this fragment and confirmed the capture/encode symbols on real
# silicon (rkvenc, the dma-heaps, HDMI-RX). Symbols outside that path are still
# reviewed intent rather than a validated result. See
# docs/kernel-build-from-source.md §"Known gaps".

# --- Build determinism -----------------------------------------------------
# LOCALVERSION_AUTO would append a git description to KERNELRELEASE, which would
# make the produced package NAME depend on the checkout state. The manifest
# declares the exact kernel_release the build must produce, so this must be off.
CONFIG_LOCALVERSION_AUTO=n
# bindeb-pkg emits a separate multi-hundred-MB linux-image-*-dbg package when
# debug info is on. The output contract is ONE linux-image deb; turn it off at
# the source rather than deleting a package we paid to build.
CONFIG_DEBUG_INFO_NONE=y

# --- Rockchip RK3588 platform ---------------------------------------------
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_PCIE_ROCKCHIP_DW=y
CONFIG_PHY_ROCKCHIP_SNPS_PCIE3=y
CONFIG_PHY_ROCKCHIP_USBDP=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_ROCKCHIP_SARADC=y

# --- Capture: SoC HDMI-RX --------------------------------------------------
# The Synopsys HDMI-RX controller behind /dev/hdmi-in. Patches 0002/0003/0005 of
# the CeraLive series (EDID visibility, replug overflow, audio capture) all land
# in this driver; without the symbol the series builds nothing.
#
# Audio capture needs 0005 AND 0006 together: 0005 registers the ASoC codec,
# 0006 is the device tree that binds it to i2s7_8ch as an ALSA card. The ASoC
# symbols that card needs — SND_SIMPLE_CARD, SND_SOC_ROCKCHIP_I2S_TDM,
# SND_SOC_HDMI_CODEC — are already =m via the in-tree defconfig, verified against
# the board's own /proc/config.gz, so this fragment does not restate them.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_SYNOPSYS_HDMIRX=m

# --- Capture: USB UVC (HDMI capture dongles, DJI-class cameras) ------------
CONFIG_USB_VIDEO_CLASS=m
CONFIG_SND_USB_AUDIO=m

# --- Encode: VEPU580 / RKVENC v2 -------------------------------------------
# Provided by patch 0001 of the series. Asserted selectable by the patches
# repo's own apply gate; asserted BUILT by the kernel-build stage's post-build
# module check.
CONFIG_VIDEO_ROCKCHIP_RKVENC=m

# --- Encode: DMA-BUF userland heaps (the MPP buffer allocator) --------------
# Rockchip MPP userspace (librockchip_mpp, which backs mpph264enc/mpph265enc)
# allocates every frame and stream buffer through its `dma_heap` allocator,
# which opens /dev/dma_heap/<name>. Those chardevs exist ONLY when
# CONFIG_DMABUF_HEAPS is enabled — and DMABUF_HEAPS is a `menuconfig bool`
# that defaults OFF, so arm64 defconfig never turns it on. It was missing here,
# and the whole /dev/dma_heap directory was therefore absent on the 7.1.5 board:
# a real `gst-launch-1.0 videotestsrc ! mpph264enc ! filesink` produced ZERO
# bytes and died at buffer negotiation, even though the rkvenc driver itself was
# built, bound to fdbd0000/fdbe0000.rkvenc-core, and exposing /dev/mpp_service.
# This is the same `menuconfig`-parent class as the CONFIG_RTW89 drop.
#
# The image's own shipped udev policy already assumes these exist — the
# rockchip-multimedia-config package's 99-rk-device-permissions.rules matches
# KERNEL=="system-dma32" / "system-uncached" / "system-uncached-dma32" and runs
# `chmod a+rw /dev/dma_heap` — so the absence was a contradiction in the image,
# not a design choice.
#
# These symbols alone were NECESSARY AND NOT SUFFICIENT, and the board proved
# it: librockchip_mpp's allocator table hard-codes the heap name
# `system-uncached`, which stock mainline never registers, so the H.264 HAL's
# init-time allocation failed and mpph264enc did not even register. It does NOT
# fall back to the `system` heap. Patch 0009 of the series adds that heap; the
# symbol below is what turns it on. See the UNCACHED block right after it.
#
# AT v7.2 BOTH OF THESE CHANGED MEANING, and the second one is now load-bearing
# in a way it was not at v7.1.7. arm64 defconfig has since gained a
# DMABUF_HEAPS=y of its own, so the first line is now an assertion rather than
# the thing that turns the menuconfig on — keep it anyway, per the stays-true
# rule. The second is the opposite: upstream made DMABUF_HEAPS_SYSTEM a TRISTATE
# and arm64 defconfig resolves it =m, while the uncached heap below carries a
# hard `depends on DMABUF_HEAPS_SYSTEM=y`. So this =y is what makes
# DMABUF_HEAPS_SYSTEM_UNCACHED selectable at all; drop it and the heap silently
# disappears with defconfig still looking perfectly reasonable.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
# Patch 0009's downstream heap, given its OWN Kconfig symbol on purpose: a
# hardware-unvalidated addition should be separately switchable, and — the part
# that matters here — verify-kernel-config.sh can only prove what the fragment
# DECLARES. Riding on the parent, the gate could assert nothing stronger than
# DMABUF_HEAPS_SYSTEM=y, which stays true even if the heap silently vanishes.
#
# Declare-the-parent: DMABUF_HEAPS_SYSTEM above is the `depends on`. The other
# dependency, ARCH_HAS_DMA_PREP_COHERENT, is `select`ed by arch/arm64/Kconfig,
# so it needs no entry — same rule as RTW89_CORE and NF_TABLES_IPV4/IPV6.
#
# Board-confirmed on a Rock 5B+: /dev/dma_heap/system-uncached is a REAL heap
# (minor 250,1 against `system`'s 250,0), mpph264enc registers, and a 1080p
# encode produces byte-identical output across repeats — where 7.1.5 produced
# zero bytes and, once aliased as a diagnostic, non-deterministic output.
CONFIG_DMABUF_HEAPS_SYSTEM_UNCACHED=y
# depends on DMABUF_HEAPS && DMA_CMA; DMA_CMA is already =y from defconfig.
CONFIG_DMABUF_HEAPS_CMA=y

# --- Networking: bonded-link uplinks ---------------------------------------
# Onboard NICs: RTL8125B (Rock 5B+, r8169) and the OPi 5+ dual r8169.
CONFIG_R8169=m
# RTL8852BE WiFi (Rock 5B+), PCI 10ec:b852.
# CONFIG_RTW89 is the `menuconfig` that gates the whole rtw89 family and it is a
# tristate defaulting OFF, so declaring only the 8852BE leaf makes olddefconfig
# discard the leaf and ship a kernel with no rtw89 driver at all — which is
# exactly what 7.1.5 did until this line was added. The leaf `select`s
# RTW89_CORE/RTW89_PCI/RTW89_8852B itself, so those need no entry. MAC80211
# (rtw89's `depends on`) is already =m from defconfig.
CONFIG_RTW89=m
CONFIG_RTW89_8852BE=m

# --- Wireless: broad adapter coverage --------------------------------------
# WHY THIS BLOCK EXISTS. Everything above this line is a symbol for silicon
# soldered to one of the two shipped boards. This block is different: it covers
# the adapter an operator FITS — the M.2 2230 card in the Rock 5B+'s E-key slot
# or the Orange Pi 5+'s, and USB dongles — which is a runtime choice no manifest
# can predict. A missing driver there is indistinguishable on the board from
# dead hardware, so the fix has to be in the image rather than in a support call.
#
# EVERY SYMBOL BELOW IS ENUMERATED AND JUSTIFIED INDIVIDUALLY. This is NOT a
# port of Armbian's edge config or a "turn on the whole WLAN menu" sweep — the
# fragment's opening SCOPE paragraph forbids exactly that. Each line names the
# adapter class it serves, and each `select`ed helper is deliberately absent
# (the RTW89_CORE rule above).
#
# THE DEFCONFIG TRAP THIS BLOCK CLOSES. Some of these are ALREADY on without the
# fragment saying anything — measured, not assumed, by resolving arm64 defconfig +
# the pinned patch series + this fragment twice (before/after this block) and
# diffing: MT7921E, IWLWIFI, IWLMVM, ATH11K, ATH11K_PCI, ATH12K, BRCMFMAC and
# BRCMFMAC_SDIO were already =m/=y, as were BT, BT_HCIBTUSB and every
# BT_HCIBTUSB_* protocol bool. Declaring them anyway is the entire point:
# `required-symbols.list` explains that the fragment gate can only prove what the
# fragment DECLARES, and this fragment turns 54 platforms off below, so a driver
# defconfig happens to supply today can stop resolving tomorrow with the build,
# the package validation and the boot all staying green. A line here that looks
# redundant against today's defconfig is the assertion that it stays true.
#
# What this block genuinely ADDS (n -> m/y, same measurement): MT7925E, MT7915E,
# MT7996E, the whole RTW88 tree, RTW89_8852AE/8852CE, BRCMFMAC_PCIE/_USB, and the
# three UART protocol bools BT_HCIUART_3WIRE/_RTL/_INTEL. Net module count over
# the whole config: 793 -> 826.
#
# FIRMWARE IS PART OF THE DECISION, and it was read out of the actual package
# rather than assumed: every claim below about a blob was checked against the
# staged `armbian-firmware` 26.8.1 `.deb`'s own file list. A leaf whose firmware
# that package does not ship is either omitted, or declared with the gap stated
# in its own comment — never declared silently.
#
# The `WLAN_VENDOR_*` symbols are the per-vendor `if` gates in
# drivers/net/wireless/*/Kconfig. Each is a bool `default y`, so each resolves on
# by itself today — and each is declared for the same reason as above: it is the
# gate that makes every leaf under it visible, which is precisely the class of
# parent CONFIG_RTW89 already shipped broken once for omitting.

# MediaTek mt76. WLAN_VENDOR_MEDIATEK is a `bool ... default y` wrapping the whole
# mt76 tree in `if WLAN_VENDOR_MEDIATEK` — it IS the family's only real parent, so
# there is no second mt76-level menuconfig this block could be accused of omitting.
# It is NOT CONFIG_ARCH_MEDIATEK, which is a foreign SoC platform disabled below.
CONFIG_WLAN_VENDOR_MEDIATEK=y
# MT7921E (PCIe, Wi-Fi 6): already =m from defconfig; pinned so it stays. Firmware
# ships as mediatek/WIFI_RAM_CODE_MT7961_1.bin (+ patch MCU) — the MT7961 name is
# the same silicon, so do not read the absent "mt7921" spelling as a missing blob.
CONFIG_MT7921E=m
# MT7925E (PCIe, Wi-Fi 7): the Orange Pi 5+ bench card's driver, measured n at this
# pin — without this line that board has no wireless driver at all. Firmware is
# present: mediatek/mt7925/WIFI_RAM_CODE_MT7925_1_1.bin + WIFI_MT7925_PATCH_MCU.
CONFIG_MT7925E=m
# MT7915E (PCIe, Wi-Fi 6 4x4): the common AP-class mt76 part in M.2 adapters.
# Firmware present: mediatek/mt7915_{rom_patch,wm,wa}.bin + the two eeprom blobs.
CONFIG_MT7915E=m
# MT7996E (PCIe, Wi-Fi 7 tri-band). ENABLED WITH A KNOWN FIRMWARE GAP: the
# armbian-firmware 26.8.1 file list contains ZERO paths matching mt7996, so this
# driver builds and binds but can never load. Declared anyway so the module exists
# the moment the blobs land; do NOT read it as a working family. Recorded in
# tmp/qa-evidence/dynamic-wifi-bt/edge-kernel-modules.txt.
CONFIG_MT7996E=m
# MT76_CORE / MT76_CONNAC_LIB / MT792x_LIB / MT79{2,5}x_COMMON are promptless
# tristates `select`ed by the leaves above — the RTW89_CORE rule, so no entry.
# Verified against the pinned tree: `config MT76_CORE` carries no prompt.

# Intel iwlwifi. WLAN_VENDOR_INTEL is the `bool ... default y` `if` gate; IWLWIFI
# is the tristate the PCI binding lives in and IWLMVM is the firmware personality
# — an IWLWIFI with no MVM binds nothing modern. Both are already =m from
# defconfig and are pinned here for the same stays-true reason as the rest.
CONFIG_WLAN_VENDOR_INTEL=y
# IWLWIFI: the family tristate carrying the PCI binding (depends on PCI && CFG80211).
CONFIG_IWLWIFI=m
# IWLMVM: the MVM firmware personality; without it IWLWIFI binds no current card.
CONFIG_IWLMVM=m
# HONEST COVERAGE LIMIT, from the firmware file list rather than the driver's
# ambitions: armbian-firmware 26.8.1 ships iwlwifi-cc-a0-59.ucode (AX200) and
# iwlwifi-ty-a0-gf-a0-{59,72,89}.ucode (AX210), plus the older 3160/3168/726x/
# 8000/8265/9260 lines. It ships NO iwlwifi-Qu*/QuZ* (AX201) and NO iwlwifi-so-*
# (AX211/AX411), so those cards bind and then fail the firmware load.
#
# NOT DECLARED, deliberately: CONFIG_IWLMLD. It is a real tristate at this pin and
# it is the personality Intel's Wi-Fi 7 parts (BE200/BE202, iwlwifi-gl-*) need —
# but no iwlwifi-gl-* blob ships either, so declaring it would add a module that
# can only ever fail to load. Same rule that omits the three rtw89 leaves below;
# MT7996E above is the ONE documented exception, and it says so in its own comment.

# Realtek rtw88 (802.11ac). RTW88 is verified in the pinned tree as
# `menuconfig RTW88 / tristate / depends on MAC80211` with NO default, and it
# measured n before this line — the exact shape that silently discarded the RTW89
# leaf at 7.1.5, so this parent is the whole reason the twelve leaves below
# resolve at all. Leaf selection is not arbitrary: every chip below has its blob
# in armbian-firmware 26.8.1 — the rtw88/ directory ships rtw8723d, rtw8821a,
# rtw8821c, rtw8822b, rtw8822c, rtw8812a and rtw8814a firmware — and leaves whose
# firmware that package does NOT ship are deliberately omitted.
# RTW88_CORE/RTW88_PCI/RTW88_USB are promptless and `select`ed by the leaves, so
# they get no entry; all three were confirmed resolving to =m in the built config.
CONFIG_RTW88=m
# PCIe (M.2 / mPCIe cards). Each `depends on PCI` and `select`s RTW88_PCI.
# RTL8822BE, 2x2 11ac dual-band — the most common rtw88 M.2 part. fw rtw8822b_fw.bin.
CONFIG_RTW88_8822BE=m
# RTL8822CE, 2x2 11ac, the 8822B's successor. fw rtw8822c_fw.bin (+ _wow_fw.bin).
CONFIG_RTW88_8822CE=m
# RTL8821CE, 1x1 11ac — very common in low-cost laptops/SBC M.2 slots. fw rtw8821c_fw.bin.
CONFIG_RTW88_8821CE=m
# RTL8723DE, 1x1 11n + BT combo, still shipped on budget boards. fw rtw8723d_fw.bin.
CONFIG_RTW88_8723DE=m
# RTL8814AE, 3x3 11ac high-gain PCIe. fw rtw8814a_fw.bin.
CONFIG_RTW88_8814AE=m
# USB dongles. Each `depends on USB` and `select`s RTW88_USB — a genuinely separate
# bus path from the PCIe leaves above, which is why one is pinned in required-symbols.
# RTL8822BU, 2x2 11ac dongle. Shares rtw8822b_fw.bin with the 8822BE.
CONFIG_RTW88_8822BU=m
# RTL8822CU, 2x2 11ac dongle. Shares rtw8822c_fw.bin with the 8822CE.
CONFIG_RTW88_8822CU=m
# RTL8821CU, 1x1 11ac dongle. Shares rtw8821c_fw.bin with the 8821CE.
CONFIG_RTW88_8821CU=m
# RTL8723DU, 1x1 11n dongle. Shares rtw8723d_fw.bin with the 8723DE.
CONFIG_RTW88_8723DU=m
# RTL8821AU / 8811AU, 1x1 11ac dongle (one symbol covers both). fw rtw8821a_fw.bin.
CONFIG_RTW88_8821AU=m
# RTL8812AU, 2x2 11ac dongle — the classic high-power USB adapter. fw rtw8812a_fw.bin.
CONFIG_RTW88_8812AU=m
# RTL8814AU, 3x3 11ac dongle. Shares rtw8814a_fw.bin with the 8814AE.
CONFIG_RTW88_8814AU=m

# Realtek rtw89 (Wi-Fi 6/6E) beyond the onboard 8852BE declared above — the
# CONFIG_RTW89 parent it needs is already declared with that board's leaf, so
# these two ride it rather than restating it. Same firmware rule, and the rtw89/
# directory was read to confirm it: it holds exactly rtw8852a_fw.bin,
# rtw8852b_fw{,-1}.bin and rtw8852c_fw{,-1}.bin.
# 8852AE (Wi-Fi 6 PCIe) — rtw8852a_fw.bin ships.
CONFIG_RTW89_8852AE=m
# 8852CE (Wi-Fi 6E PCIe) — rtw8852c_fw.bin + rtw8852c_fw-1.bin ship.
CONFIG_RTW89_8852CE=m
# NOT DECLARED, deliberately: RTW89_8851BE, RTW89_8852BTE and RTW89_8922AE. All
# three are real symbols at this pin, but that same directory listing carries no
# rtw8851b/rtw8852bt/rtw8922a blob, so each would be a module that can only ever
# fail to load.

# Broadcom FullMAC. THE MOST CONSEQUENTIAL LINE IN THIS BLOCK IS BRCMFMAC_PCIE.
# BRCMFMAC is =m from defconfig, but its BUS interfaces are separate bools INSIDE
# the driver and, verified in the pinned tree, only BRCMFMAC_SDIO carries
# `default y`. So a defconfig brcmfmac binds SDIO parts ONLY — and the Orange Pi
# 5+'s AP6275P is a PCIe part, i.e. the driver was present and could never have
# bound it. Both measured n before this block. The firmware confirms the part is
# otherwise ready to go: brcm/brcmfmac43752-pcie.bin + .clm_blob + .txt all ship.
CONFIG_WLAN_VENDOR_BROADCOM=y
# BRCMFMAC: the FullMAC driver itself. Already =m; it is the parent all three bus
# bools below `depends on`, so losing it would take every bus interface with it.
CONFIG_BRCMFMAC=m
# SDIO: already `default y`; pinned so a bus interface cannot vanish silently.
CONFIG_BRCMFMAC_SDIO=y
# PCIe: the AP6275P bus. No `default` in Kconfig — this line is what enables it.
CONFIG_BRCMFMAC_PCIE=y
# USB: brcmfmac dongles. No `default` in Kconfig either.
CONFIG_BRCMFMAC_USB=y

# Qualcomm ath11k (Wi-Fi 6) and ath12k (Wi-Fi 7). WLAN_VENDOR_ATH is the
# `bool ... default y` `if` gate. MHI_BUS/QRTR/QRTR_MHI are `select`ed by both
# leaves — confirmed =m in the built config — so they get no entry.
CONFIG_WLAN_VENDOR_ATH=y
# ATH11K is the family tristate; ATH11K_PCI is its SEPARATE PCI bus leaf, so the
# pair is required and neither alone is a usable adapter. Both already =m.
# FIRMWARE TRUTH, and it is narrower than the driver: of the two ath11k parts
# armbian-firmware 26.8.1 knows about, only WCN6855 is complete (amss.bin,
# board-2.bin, m3.bin, regdb.bin). ath11k/QCA6390/ ships board-2.bin and NOTHING
# else — no amss.bin, no m3.bin — so a QCA6390 binds and then fails its firmware
# load. Read this family as WCN6855-capable, not as "ath11k works".
CONFIG_ATH11K=m
# ATH11K_PCI: the PCI bus leaf, a SEPARATE tristate (depends on ATH11K && PCI).
CONFIG_ATH11K_PCI=m
# ath12k has NO ATH12K_PCI symbol at this pin — verified twice over: no such
# `config` exists in the tree, and drivers/net/wireless/ath/ath12k/Makefile lists
# pci.o in the unconditional `ath12k-y` object list. So ATH12K alone IS the PCIe
# leaf, and adding an ATH12K_PCI line would fail the gate as a nonexistent symbol.
# (ATH12K_AHB does exist but is an IPQ5332 SoC bus needing REMOTEPROC — not an
# M.2 card, so it is deliberately absent.) Firmware is complete for both parts:
# ath12k/WCN7850/hw2.0/ and WCN7860/hw2.0/ each carry amss/board-2/m3/regdb.
CONFIG_ATH12K=m

# --- Bluetooth: USB and UART transports ------------------------------------
# BT is a `menuconfig` tristate and BT_HCIBTUSB/BT_HCIUART are the two transport
# tristates under it — the same parent/leaf shape as RTW89.
#
# THE VENDOR HELPERS ARE NOT DECLARED HERE, DELIBERATELY. BT_INTEL, BT_BCM,
# BT_RTL and BT_MTK are PROMPTLESS tristates in drivers/bluetooth/Kconfig with no
# `default`: kconfig cannot set them at all, only a `select` can. Declaring one
# directly would be a line olddefconfig discards unless something else happened
# to select it — the CONFIG_RTW89 failure mode wearing the opposite mask. The
# symbols that actually turn them on are the per-protocol bools below, so those
# are what this fragment declares; the resolved helpers are asserted in
# required-symbols.list, which is the manifest for what the kernel must CARRY.
# BT and the USB transport are already =m from defconfig; both are pinned because
# every BT_HCIBTUSB_* bool below is `depends on BT_HCIBTUSB`, so losing the
# transport would silently take all four vendor helpers with it.
CONFIG_BT=m
# BT_HCIBTUSB: the USB transport tristate, and the only path by which BT_INTEL is
# turned on (it `select`s it directly — there is no BT_HCIBTUSB_INTEL bool).
CONFIG_BT_HCIBTUSB=m
# Selects BT_MTK — the Orange Pi 5+'s MediaTek USB radio, whose firmware ships as
# mediatek/mt7925/BT_RAM_CODE_MT7925_1_1_hdr.bin. It is the one protocol bool
# Kconfig marks `default n`; it nonetheless measured y already, so this line is an
# assertion rather than a change — and it is the one most worth asserting, because
# it is the only one whose Kconfig default would not restore it.
CONFIG_BT_HCIBTUSB_MTK=y
# Selects BT_RTL — the Rock 5B+'s RTL8852BE Bluetooth half (USB 13d3:3572);
# rtl_bt/ ships its blobs. `default y` in Kconfig, pinned so it stays.
CONFIG_BT_HCIBTUSB_RTL=y
# Selects BT_BCM — Broadcom/Cypress combo cards paired with brcmfmac above.
# `default y` in Kconfig, pinned so it stays.
CONFIG_BT_HCIBTUSB_BCM=y
# BT_INTEL needs no bool of its own: BT_HCIBTUSB `select`s it directly (verified
# in drivers/bluetooth/Kconfig), and intel/ibt-* firmware ships.
# UART transport: the shape every SDIO/PCIe combo module's BT half uses, where
# the radio hangs off a serial port rather than USB. Already =m; pinned as the
# parent all seven protocol bools below `depends on`.
CONFIG_BT_HCIUART=m
# serdev binds a UART-attached controller as a device instead of requiring a
# userspace hciattach. Promptless with `default y`, gated on SERIAL_DEV_BUS, and
# four of the protocol bools below hard-`depends on` it — so it is declared as an
# assertion, and SERIAL_DEV_BUS/SERIAL_DEV_CTRL_TTYPORT are pinned in
# required-symbols.list for the reason spelled out there.
CONFIG_BT_HCIUART_SERDEV=y
# H4 is the baseline framing every UART controller speaks; several bools below
# `select` it. Already y.
CONFIG_BT_HCIUART_H4=y
# Three-wire (H5) framing — measured n before this block, and BT_HCIUART_RTL
# `select`s it, so declaring it makes the dependency explicit rather than lucky.
CONFIG_BT_HCIUART_3WIRE=y
# Selects BT_BCM for UART-attached Broadcom/Cypress parts (AP6275P class). It was
# already y, and it is the most fragile line here: its Kconfig reads
# `depends on (!ACPI || SERIAL_DEV_CTRL_TTYPORT)`, and arm64 defconfig sets
# ACPI=y — so it survives ONLY because SERIAL_DEV_CTRL_TTYPORT resolves y, which
# in turn holds only while SERIAL_DEV_BUS is =y rather than =m. Neither of those
# is visible from this line, which is exactly why both are in required-symbols.
CONFIG_BT_HCIUART_BCM=y
# Selects BT_RTL for UART-attached Realtek parts — measured n before this block.
CONFIG_BT_HCIUART_RTL=y
# Selects BT_INTEL for UART-attached Intel parts — measured n before this block.
CONFIG_BT_HCIUART_INTEL=y
# Selects BT_QCA for UART-attached Qualcomm parts; qca/ firmware ships. Already y.
CONFIG_BT_HCIUART_QCA=y

# WWAN: the six modules lib/check-wwan-modules.sh binds the modem stack to.
# Keep this list in lockstep with that checker — a drop here is exactly the
# regression it exists to catch.
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_WDM=m
CONFIG_USB_SERIAL_OPTION=m

# --- Networking: LAN-ingest ingress firewall (nftables) --------------------
# ceralive-ingest-firewall.service loads /etc/ceralive/ingest-firewall.nft with
# `nft -f` at boot. That ruleset IS the LAN boundary around the UNAUTHENTICATED
# MediaMTX ingest gateway: it DROPs inbound RTMP :1935 and SRT :4001 whenever they
# arrive on a usb*/enx*/ww*/ppp* WAN uplink. CONFIG_NF_TABLES is a tristate with a
# prompt and NO `default`, and everything else in the family sits inside its
# `if NF_TABLES` block, so arm64 defconfig never turns it on and this fragment
# never named it — the same `menuconfig`-parent class as the CONFIG_RTW89 and
# CONFIG_DMABUF_HEAPS drops. Like both of those it failed in complete build-side
# silence: the deb validated on all four axes, /boot was complete, the image
# booted, and the only thing that ever said so was the unit on the board.
#
# Confirmed live on a Rock 5B+ running the edge 7.1.5 kernel:
#
#   systemctl status ceralive-ingest-firewall.service
#     Active: failed (Result: exit-code)
#     ExecStart=/usr/sbin/nft -f /etc/ceralive/ingest-firewall.nft (status=3)
#     nft[182]: mnl.c:60: Unable to initialize Netlink socket: Protocol not supported
#   modprobe nfnetlink
#     FATAL: Module nfnetlink not found in directory /lib/modules/7.1.5-ceralive-rk3588
#   zcat /proc/config.gz | grep -iE 'NF_TABLES|NETFILTER'
#     # CONFIG_NF_TABLES is not set
#     CONFIG_NETFILTER=y
#     CONFIG_NETFILTER_ADVANCED=y
#
# The socket `nft` cannot open is NETLINK_NETFILTER, which comes from
# CONFIG_NETFILTER_NETLINK — a promptless tristate that NOTHING selects until
# NF_TABLES is on. That is why the board reports a missing netlink PROTOCOL rather
# than a missing table, and why chasing `nfnetlink` as a module is a dead end. It
# is `select`ed by the symbol below and so needs no entry of its own.
#
# =y rather than =m: the ruleset is installed by a DefaultDependencies=no oneshot
# ordered Before= the gateway opens its listeners, so the boundary has to exist
# before any modular autoload could plausibly have run.
CONFIG_NF_TABLES=y
# The ruleset declares `table inet ceralive_ingest_fw` — one table covering v4 and
# v6 — which is exactly what this bool provides. It `depends on IPV6`, already =y
# from defconfig and verified against the board's own /proc/config.gz, and it
# `select`s NF_TABLES_IPV4/NF_TABLES_IPV6, so neither of those needs an entry.
CONFIG_NF_TABLES_INET=y
# NOT DECLARED, deliberately: CONFIG_NFT_COUNTER. The `counter` statement in the
# ruleset is real and load-bearing — it is what makes a drop visible in
# `nft list ruleset` for on-device diagnosis — but v7.2 has no such symbol either:
# net/netfilter/Makefile builds nft_counter.o unconditionally into nf_tables-objs,
# next to nft_meta.o (the `iifname` match) and nft_chain_filter.o (the
# `type filter hook input` base chain). Declaring it would resolve to nothing and
# verify-kernel-config.sh would correctly fail the build over a symbol the kernel
# does not have. Declare the value kconfig can actually give, exactly as with
# CONFIG_TYPEC_FUSB302 below.

# --- Networking: uplink sharing — steering + shaping (REQ-USB-080..084) -----
# A SECOND nftables consumer, entirely disjoint from the ingest firewall above.
# ceralive-share.service applies `table inet ceralive_share`, which CeraUI's
# uplink-steering module renders to /run/ceralive/share.nft: client-zone traffic
# is ct-marked, steered onto a per-uplink `ip rule` band, and masqueraded per
# uplink; the uplink-shaper module then classifies that marked traffic into the
# rate-capped band of a two-band root qdisc while local/SRT traffic rides the
# uncapped one.
#
# Everything below was UNDECLARED before this block, and on this repo's own
# evidence that is not the same as "off but harmless": `merge_config.sh -m`
# reports only REDEFINED values, so a leaf whose menuconfig parent is undeclared
# is dropped by `make olddefconfig` in complete silence — the RTW89 /
# DMABUF_HEAPS / TYPEC_FUSB302 / NF_TABLES class, four times over.
#
# =y rather than =m throughout, for the same reason CONFIG_NF_TABLES is =y above:
# on a track this repo BUILDS there is no reason to reintroduce a load-ordering
# question it can simply not have. It is also the only safe value under an EXACT
# -match gate — a =m declaration is at the mercy of any future `select` that
# forces =y, while a =y whose every dependency is declared =y in this same
# fragment is always satisfiable. The SHIPPED vendor 6.1 kernel carries this
# whole closure as MODULES instead; that difference is measured and recorded in
# docs/notes/sharing-qdisc-matrix.md and is not a defect on either track.
#
# NOT DECLARED, deliberately — CONFIG_NET_CLS, CONFIG_NF_DEFRAG_IPV4,
# CONFIG_NF_DEFRAG_IPV6, CONFIG_NF_NAT_MASQUERADE and CONFIG_NETFILTER_NETLINK
# are promptless symbols `select`ed by the ones below, so they need no entry of
# their own — the same select/leaf rule as RTW89_CORE and NF_TABLES_IPV4.

# Conntrack: the provenance the steering scope invariant is built on. The
# CLIENT_FLOW bit is a ct mark set ONLY in client-zone prerouting, and every
# masquerade rule matches it — so NF_CONNTRACK_MARK is what makes "this packet
# entered from a client zone" survive into postrouting. NETFILTER_ADVANCED is
# declared because NF_CONNTRACK_MARK depends on it; it is already =y on the
# board's own /proc/config.gz (see the nftables block above), so this line
# records the parent rather than changing anything.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
# The MARK-SCOPED hard-down flush. On a hard-DOWN uplink the steering layer runs
# `conntrack -D --mark <m> --mask <mask>` between the transition ruleset and the
# route-support removal; that command speaks ctnetlink, which is this symbol.
# Without it the drain silently no-ops and every established client flow stays
# pinned to an uplink that is already gone.
CONFIG_NF_CT_NETLINK=y
# NAT: NFT_NAT and NFT_MASQ both `depends on NF_NAT`, so the parent gets its own
# line — an undeclared tristate parent is exactly how the leaves disappear.
CONFIG_NF_NAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
# Weighted selection. The ruleset picks a per-uplink bucket with a
# `numgen random mod <N> : verdict` map; without this the whole balancer degrades
# to a single uplink.
CONFIG_NFT_NUMGEN=y
# The per-uplink `ip rule` band the marks select into, used by CeraUI's
# uplink-steering module for its client-zone band. (It is NOT the retired SRTLA
# source-policy layer — that installed priority-100 source rules and was removed
# outright; nothing re-adds them.)
#
# IP_ADVANCED_ROUTER is IP_MULTIPLE_TABLES' `depends on` parent, and it is a bare
# prompted bool with no default, so arm64 defconfig leaves it off and the leaf is
# DROPPED in silence — the same menuconfig-parent shape that already cost this
# fragment RTW89, DMABUF_HEAPS and NF_TABLES. Declaring the leaf alone fails
# verify-kernel-config.sh; do not "fix" that by deleting the leaf.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# Traffic control. NET_SCHED is a `menuconfig bool` and every qdisc and
# classifier below lives inside its `if NET_SCHED` block — the same parent shape
# that lost RTW89 its leaves.
CONFIG_NET_SCHED=y
# Root hierarchy: a 2-band `prio` whose band 0 (local + SRT) is UNCAPPED with an
# fq_codel child, and whose band 1 (client traffic) carries the only rate ceiling.
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_FQ_CODEL=y
# The client band's cap. CAKE is preferred; HTB is the fallback the shaper picks
# at RUNTIME when cake is unavailable, so BOTH are declared. Declaring cake here
# does NOT retire that fallback — the engine cannot assume a kernel it did not
# build (rationale in docs/notes/sharing-qdisc-matrix.md §1a).
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_CAKE=y
# The bridge between the two halves: `tc filter … handle <fwmark> fw classid`
# maps the skb mark nftables set onto the client band.
#
# THIS DECLARATION IS NOW THE WHOLE UPLINK-SHAPER CAPABILITY. The prebuilt vendor
# kernel never built the symbol, so the image used to carry `ceralive-cls-fw` — a
# separately built, vermagic-pinned out-of-tree cls_fw.ko. This fragment is the
# production kernel's config now, so the classifier is in-tree, built-in, and
# that package is retired (docs/notes/sharing-kernel-capability.md §2c). `=y`
# rather than `=m`: an out-of-tree module needed a modules-load.d entry to be
# present before the shaper first ran, and built-in removes the question.
CONFIG_NET_CLS_FW=y

# --- Type-C / USB role switching -------------------------------------------
# The FUSB302/TCPM connector mkosi/runtime/ceralive-typec-policy.sh acts on.
# It leaves port_type at dual and requests a bounded DR_SWAP to host on a
# settled sink/device attach. Without TYPEC_TCPM + TYPEC_FUSB302 there is no
# /sys/class/typec/port0 for that policy to read and the camera-enumeration race
# returns.
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
# FUSB302 carries `depends on DRM || DRM=n`, and arm64 defconfig builds DRM as a
# module, so kconfig caps this at =m however loudly the fragment asks for =y.
# It asked for =y for three releases and silently got =m. That is tolerable —
# udev auto-loads typec_fusb302 off the I2C node's OF modalias during ordinary
# boot, and the role policy is driven by udev add events on the port and its
# partner rather than by a fixed boot-time settle — so the honest value is
# declared here instead. Do NOT "fix" this by setting CONFIG_DRM=y.
CONFIG_TYPEC_FUSB302=m
CONFIG_USB_ROLE_SWITCH=y

# --- Storage / rootfs ------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=m
CONFIG_OVERLAY_FS=m

# --- systemd / RAUC prerequisites ------------------------------------------
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_EFIVAR_FS=n
CONFIG_FANOTIFY=y
CONFIG_AUTOFS_FS=y

# --- Rockchip-only platform scope ------------------------------------------
# arm64 `defconfig` is a MULTI-PLATFORM config: it turns on every SoC-vendor
# platform arch/arm64/Kconfig.platforms offers, and each one drags in its own
# clock, pinctrl, PHY, DMA, thermal, mailbox and media drivers. None of that
# silicon exists on an RK3588 appliance, so every one of those modules is code
# that ships in the rootfs, is scanned by depmod, is carried in both RAUC slots,
# and can never bind to anything.
#
# The whole set is disabled EXCEPT CONFIG_ARCH_ROCKCHIP. These are the prompted
# platform symbols of the pinned v7.2 tree, enumerated from
# arch/arm64/Kconfig.platforms rather than hand-listed.
#
# RE-ENUMERATE THIS BLOCK AT EVERY BASE BUMP. An earlier version of this comment
# claimed a platform upstream adds later "is simply absent here rather than
# silently re-enabled under a stale list". That is FALSE, and v7.2 is the proof:
# ARCH_ASPEED was added to arch/arm64/Kconfig.platforms AND to arm64 defconfig
# in the same release, so being absent from this list means defconfig's own `=y`
# survives untouched — silently re-enabled, exactly what the list exists to stop.
# The stale-list failure mode is a MISSING line, not a leftover one, and only a
# full prompt-vs-list diff against the new tree can find it.
#
# CONFIG_ARCH_REALTEK IS NOT THE Wi-Fi ADAPTER. It is Realtek's RTD12xx/RTD16xx
# SoC platform; the Rock 5B+ RTL8852BE is CONFIG_RTW89_8852BE above, a PCIe
# device driver with no relationship to this symbol. Disabling this does not
# touch Wi-Fi, and re-enabling it would not fix a Wi-Fi problem.
#
# The per-SoC leaves (ARCH_TEGRA_*_SOC, ARCH_R8A*/R9A*, …) live inside their
# parent's `if` block and need no entry — the same select/leaf rule as
# RTW89_CORE and NF_TABLES_IPV4. Declaring the parents is the whole mechanism.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BITMAIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_LAN969X is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_MMP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_PENSANDO is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
