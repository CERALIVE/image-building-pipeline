# CeraLive RK3588 `edge` kernel — REQUIRED symbol closure
#
# Checked against a REAL resolved `.config` by
# `lib/verify-kernel-config.sh --config <.config> --required <this file>`.
#
# WHAT THIS IS FOR, and why it is not a duplicate of rk3588-edge.fragment.
#
# The fragment declares what CeraLive ADDS to arm64 `defconfig`. This file
# declares what the finished kernel must CARRY — including everything defconfig
# is currently expected to supply on its own. Those are different claims, and
# only the second one survives a change to the fragment: the moment the fragment
# turns a platform, a bus or a subsystem OFF (which the Rockchip-only block now
# does, for 55 foreign platforms at once), a driver defconfig used to provide can
# stop being visible, and the fragment gate cannot notice because the fragment
# never named it.
#
# EVERY ENTRY IS A DEPENDENCY CLOSURE, PARENTS INCLUDED. This repository has now
# lost four separate capabilities to exactly one mistake — naming a leaf whose
# `menuconfig` PARENT was off, so `olddefconfig` discarded the leaf in silence
# while the build, the package validation, the boot and the image all stayed
# green: CONFIG_RTW89 (no Wi-Fi), CONFIG_DMABUF_HEAPS (no /dev/dma_heap, so MPP
# encode produced zero bytes), CONFIG_TYPEC_FUSB302 (a `=y` quietly resolving to
# `=m` for three releases) and CONFIG_NF_TABLES (no nftables at all, so the
# WAN-side drop of the unauthenticated ingest ports never applied). So each block
# below lists the parent that makes its leaves visible, not just the leaves.
#
# TWO ENTRY FORMS:
#   CONFIG_X=<value>   exact — the value is part of the requirement
#   CONFIG_X           set to anything — used for a `menuconfig` PARENT whose own
#                      y/m value is defconfig's business, but whose PRESENCE is
#                      what keeps every leaf under it visible
#
# A bare parent is deliberately NOT pinned to a value: pinning it would make an
# upstream y->m change fail the build for a difference that changes nothing about
# what the device can do. The leaves under it are pinned exactly, which is where
# built-in-vs-module actually matters.

# --- MMC / eMMC / microSD ---------------------------------------------------
# MMC is the `menuconfig` parent; every host controller below sits inside it.
# The board boots from eMMC through sdhci-dwcmshc and from microSD through
# dw_mmc-rockchip, and BOTH slots of the A/B layout live on that media.
CONFIG_MMC
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_CQHCI=y

# --- PCIe ------------------------------------------------------------------
# Carries the RTL8125B NIC and the RTL8852BE Wi-Fi adapter on the Rock 5B+, and
# the dual r8169 NICs on the Orange Pi 5+. PCIE_DW/PCIE_DW_HOST are selected by
# the Rockchip controller, and PCI is the parent both sit under.
CONFIG_PCI
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_DW=y
CONFIG_PCIE_DW_HOST=y
CONFIG_PCIE_ROCKCHIP_DW=y
CONFIG_PHY_ROCKCHIP_SNPS_PCIE3=y

# --- USB -------------------------------------------------------------------
# USB_SUPPORT is the outermost `menuconfig`; USB_SERIAL and USB_NET_DRIVERS are
# each a second-level parent, and dropping either silently removes the modem
# stack's control port or its data interfaces respectively while leaving the
# fragment's own leaf lines looking satisfied.
CONFIG_USB_SUPPORT
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_PHY_ROCKCHIP_USBDP=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=m
CONFIG_USB_SERIAL
CONFIG_USB_SERIAL_OPTION=m
# qcserial — the control-port driver for Qualcomm-based USB modems that do NOT
# present the `option` interface layout. USB_SERIAL_WWAN is the shared helper
# both it and USB_SERIAL_OPTION `select`; it is a PROMPTLESS tristate that
# kconfig cannot set at all, which makes this manifest the honest place to
# assert it — a select-only symbol is exactly what this file is for.
CONFIG_USB_SERIAL_QUALCOMM=m
CONFIG_USB_SERIAL_WWAN=m
# CDC-ACM — the /dev/ttyACM* AT control port a large share of USB modems expose.
# Supplied by defconfig today, which is why it is pinned: "defconfig happens to
# provide it" is the claim that stops being true in silence.
CONFIG_USB_ACM=m
CONFIG_USB_NET_DRIVERS
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
# Host-side RNDIS, for USB modems whose only mode is RNDIS. It reached the
# fragment in PR #144 and was never mirrored here, so the fragment line was its
# ONLY assertion — precisely the asymmetry this file exists to close, since a
# later edit deleting that line would have removed the last thing checking it.
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_WDM=m
CONFIG_USB_VIDEO_CLASS=m
CONFIG_TYPEC
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_FUSB302=m
CONFIG_USB_ROLE_SWITCH=y

# --- Cellular modem: the PCIe (MHI) transport -------------------------------
# The USB block above is one of the two ways a modem attaches; this is the other.
# An M.2 / PCIe Qualcomm modem speaks MHI, not USB, so none of the cdc/option
# symbols above can reach it and its absence looks exactly like "no modem".
#
# WWAN is the `tristate "WWAN Driver Core"` MENUCONFIG PARENT — both leaves below
# sit inside its `if WWAN` block, so losing it discards both in silence, which is
# this file's founding failure mode. It is bare rather than pinned to a value
# because its own m-vs-y is defconfig's business; the leaves are pinned exactly,
# and they can only be =m while the parent is =m.
#
# MHI_BUS is the transport itself. It is `select`ed by the ath11k/ath12k leaves,
# but the two MHI_WWAN leaves `depends on` it and select nothing, so dropping
# both Wi-Fi leaves would take the modem path with them — that is why it is
# pinned here and declared in the fragment rather than left select-only.
CONFIG_WWAN
CONFIG_MHI_BUS=m
CONFIG_MHI_WWAN_CTRL=m
CONFIG_MHI_WWAN_MBIM=m

# --- Wi-Fi and Bluetooth ----------------------------------------------------
# WLAN is the parent; WLAN_VENDOR_REALTEK and WLAN_VENDOR_BROADCOM are the
# per-vendor gates inside it, and RTW89 is the third level that already shipped
# broken once. Both shipped boards are covered: RTL8852BE (Rock 5B+) and the
# AP6275P/brcmfmac part (Orange Pi 5+). BT is its own parent — the Bluetooth
# radio enumerates over USB even though the Wi-Fi half is PCIe.
CONFIG_WLAN
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW89=m
CONFIG_RTW89_8852BE=m
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BT
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_RTL=m
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_R8169=m

# --- Wi-Fi: the FITTED-adapter closure -------------------------------------
# Everything above is silicon soldered to a shipped board. This block is the
# adapter an operator puts in the M.2 E-key slot or a USB port, which no manifest
# can predict — so the requirement is that the finished kernel CARRIES the
# driver, not that any particular board uses it. Each vendor gate is listed with
# its leaves for the reason this file's header gives: the fragment disables 55
# platforms, and a leaf whose vendor gate stopped resolving would vanish in
# silence.
#
# Bus leaves are pinned exactly; the promptless `select`ed helpers (MT76_CORE,
# MT792x_LIB, RTW88_CORE, ATH_COMMON, MHI_BUS, QRTR...) are not listed, being
# implied by the leaves that select them.
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_MT7915E=m
CONFIG_MT7996E=m
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_WLAN_VENDOR_ATH=y
# ATH11K + ATH11K_PCI are a PAIR: the family tristate carries no bus, so an
# ath11k without its PCI leaf is a driver no M.2 card can bind to. NOTE the
# firmware is narrower than the driver — armbian-firmware 26.8.1 completes
# WCN6855 only; its ath11k/QCA6390/ holds board-2.bin with no amss.bin or m3.bin.
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
# ath12k has no ATH12K_PCI symbol — pci.o is in the unconditional `ath12k-y`
# object list, so this one entry IS the PCIe requirement.
CONFIG_ATH12K=m
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
# One USB leaf is pinned alongside the PCIe ones on purpose: the USB dongles go
# through the separate promptless RTW88_USB helper, so a PCIe-only requirement
# would keep passing while every USB adapter silently stopped resolving.
CONFIG_RTW88_8822BU=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852CE=m
# brcmfmac's bus interfaces are bools INSIDE the driver, and only SDIO defaults
# on — a brcmfmac with no PCIE cannot bind an AP6275P-class card at all.
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_USB=y

# --- Bluetooth: transports and the vendor helpers they select ---------------
# BT_INTEL/BT_BCM/BT_MTK are PROMPTLESS tristates that only a `select` can turn
# on, so they cannot be declared in the fragment — this manifest is where their
# resolved presence is asserted, which is exactly the claim it exists to make.
# (BT_RTL is already pinned above with the onboard RTL8852BE.)
CONFIG_BT_INTEL=m
CONFIG_BT_BCM=m
CONFIG_BT_MTK=m
CONFIG_BT_QCA=m
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_HCIUART_INTEL=y
CONFIG_BT_HCIUART_QCA=y
# THE TWO SILENT GATES UNDER THE UART BLOCK ABOVE, and the reason they are pinned
# HERE rather than left implicit. BT_HCIUART_SERDEV is promptless `default y` but
# `depends on SERIAL_DEV_BUS`, and SERIAL_DEV_CTRL_TTYPORT is a prompted bool
# whose own `default y` holds only while `SERIAL_DEV_BUS != m`. BT_HCIUART_BCM
# then reads `depends on (!ACPI || SERIAL_DEV_CTRL_TTYPORT)` — and arm64 defconfig
# sets ACPI=y, so the Broadcom UART protocol survives ONLY through that second
# symbol. Flip SERIAL_DEV_BUS to =m and the chain collapses: CTRL_TTYPORT goes
# not-set, BT_HCIUART_BCM is dropped, and nothing above says why. Pinning
# SERIAL_DEV_BUS at =y specifically (never merely "set") is the load-bearing part.
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y

# --- Bluetooth: the BR/EDR PROTOCOL modules ---------------------------------
# Everything above is TRANSPORT — it gets a controller onto the bus. These two
# are the protocols BlueZ opens sockets on once it is there, and both measured
# `is not set`, so they are a real capability gain rather than an assertion.
#
# BT_BREDR is their `depends on` parent: a `bool ... default y` under BT. It is
# pinned at =y specifically, not left bare, because it is a BOOL — there is no
# m-vs-y for defconfig to have an opinion about, and n is the one value that
# would silently take both leaves with it.
#
# RFCOMM carries the HFP/HSP control channel, which is how a Bluetooth
# MICROPHONE is reached: PipeWire's BlueZ backend opens BTPROTO_RFCOMM sockets
# directly, so this is the kernel half of a capability whose userspace the image
# already ships. BNEP is Ethernet-over-Bluetooth, required by bluetoothd's PAN
# profile registration.
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m

# --- DRM / kiosk display ----------------------------------------------------
# The kiosk stack (cage + Chromium, or the Cog add-on) renders onto a Rockchip
# DRM/KMS device; DRM_ROCKCHIP is what creates it, and ROCKCHIP_DW_HDMI_QP is the
# RK3588 HDMI transmitter it drives.
CONFIG_DRM
CONFIG_DRM_ROCKCHIP=m
CONFIG_ROCKCHIP_DW_HDMI_QP=y
CONFIG_DRM_DISPLAY_HELPER=m

# The GPU itself. On this mainline track the Mali-G610 is bound by the in-tree
# open `panthor` driver, NOT by Rockchip's out-of-tree vendor module + libmali
# blob — that pairing retires with the vendor kernel era, and the blob is
# ABI-incompatible with trixie's stack besides (armbian/build#10320). Panthor is
# the CSF-generation driver and is the correct one for a G610: panfrost handles
# the non-CSF Valhall parts (G68/G78), which this SoC is not.
#
# It is pinned HERE and NOT in rk3588-edge.fragment on purpose, and the
# distinction is this file's whole reason to exist: arm64 defconfig already sets
# it, so the fragment (which declares what CeraLive ADDS) has nothing to add —
# but "defconfig happens to supply it" is exactly the claim that stops being true
# in silence. CONFIG_RTW89, CONFIG_DMABUF_HEAPS, CONFIG_TYPEC_FUSB302 and
# CONFIG_NF_TABLES each shipped a dead capability on a booting, validating image
# for that reason.
#
# `=m` is the honest RESOLVED value, not a preference: arm64 defconfig builds
# CONFIG_DRM=m, and a tristate that `depends on DRM` cannot resolve `=y` above a
# modular parent. Verified against the real resolved v7.2 config for this variant
# (rk3588-kernel-patches .omo/evidence/v72-rebase/05-compile/resolved.config:
# CONFIG_DRM=m, CONFIG_DRM_PANTHOR=m). Its select-only helpers — DRM_EXEC,
# DRM_GPUVM, DRM_SCHED, DRM_GEM_SHMEM_HELPER, IOMMU_IO_PGTABLE_LPAE — need no
# entry, per the select-only rule this file already applies to RTW89_CORE.
CONFIG_DRM_PANTHOR=m

# --- Audio ------------------------------------------------------------------
# SOUND -> SND -> SND_SOC is a three-deep parent chain, and SND_USB is a fourth
# parent that gates the USB-audio leaf specifically. HDMI-RX embedded audio is a
# simple-audio-card binding SND_SOC_HDMI_CODEC to the capture-only i2s7_8ch
# (SND_SOC_ROCKCHIP_I2S_TDM); the always-on level meter reads the ALSA capture
# device those produce.
CONFIG_SOUND
CONFIG_SND
CONFIG_SND_SOC
CONFIG_SND_SIMPLE_CARD=m
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=m
CONFIG_SND_SOC_HDMI_CODEC=m
CONFIG_SND_USB
CONFIG_SND_USB_AUDIO=m

# --- Capture, encode and decode (media island / HDMI-RX) --------------------
# MEDIA_SUPPORT is the parent of the whole V4L2 tree. MEDIA_PLATFORM_DRIVERS is the
# `if` gate around every `source` line in drivers/media/platform/Kconfig, so it is
# the real parent of BOTH the Synopsys HDMI-RX driver and the Rockchip m2m drivers
# below; MEDIA_PLATFORM_SUPPORT only gates the `source` of that file, which is why
# naming it alone was never the whole closure. V4L_MEM2MEM_DRIVERS is a second
# prompted bool with no default that VIDEO_ROCKCHIP_RGA and VIDEO_HANTRO each
# `depends on` directly.
#
# VIDEO_SYNOPSYS_HDMIRX is supplied by the pinned patch series, so an absence here
# means the series did not apply or its Kconfig hunk was lost — which is
# indistinguishable from a working build until a board tries to capture.
CONFIG_MEDIA_SUPPORT
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_SYNOPSYS_HDMIRX=m

# --- The CeraLive RK3588 media island (MPP service + three clients) ---------
# VIDEO_ROCKCHIP_RKVENC=m USED TO BE THE ROW HERE AND THE SYMBOL NO LONGER EXISTS.
# The `island/` lane retired patch 0001 and its nine rkvenc siblings; hardware encode
# is now one client of the Rockchip MPP service carried as source by
# `rk3588-media-island`. What the finished kernel must CARRY is the service module
# plus the three clients compiled into it.
#
# ROCKCHIP_MPP_SERVICE is the only tristate of the four — RKVENC2, RKVDEC2 and
# JPGDEC are bools inside its `if` block, linked into `rk_vcodec.ko` — so their
# values are `=y` and a `=m` here would be a manifest that can never be satisfied.
#
# ROCKCHIP_MPP_PROC_FS IS PROMPTLESS, WHICH IS WHY IT IS HERE AND NOT IN THE
# FRAGMENT. kconfig cannot be directed by a fragment line for a symbol with no
# prompt (the BT_INTEL/BT_MTK rule), and it is not cosmetic: `/proc/mpp_service/load`
# and `sessions-summary` are the island's frozen operator telemetry surface, and the
# driver treats a missing procfs root as an init failure rather than a degraded
# start. PROC_FS is its `depends on`.
CONFIG_PROC_FS=y
CONFIG_ROCKCHIP_MPP_SERVICE=m
CONFIG_ROCKCHIP_MPP_PROC_FS=y
CONFIG_ROCKCHIP_MPP_RKVENC2=y
CONFIG_ROCKCHIP_MPP_RKVDEC2=y
CONFIG_ROCKCHIP_MPP_JPGDEC=y

# --- Mainline media drivers that stay BUILT alongside the island ------------
# VIDEO_ROCKCHIP_VDEC is the reversibility guarantee, not a live decoder: the island
# owns both decoder nodes by `compatible`, so this driver binds nothing and is kept
# built purely so the handover can be undone by a device-tree change instead of a
# kernel rebuild. VIDEO_HANTRO keeps vpu121/vepu121_0/av1d, which the island never
# claims. RGA moves at this pin, so the island driver is required below and the
# mainline driver is forbidden instead.
CONFIG_VIDEO_ROCKCHIP_VDEC=m
CONFIG_VIDEO_HANTRO=m
# The V4L2 core facilities all three `select`, asserted as resolved rather than
# declared in the fragment — a `select`ed symbol named in a fragment is at the mercy
# of its selectors, so the fragment gate is the wrong place for it and this manifest
# is the right one. MEDIA_CONTROLLER and VIDEO_V4L2_SUBDEV_API are bools, so their
# value is pinned; V4L2_MEM2MEM_DEV is a promptless TRISTATE whose y-vs-m is decided
# by whichever driver selects it, so it is deliberately left unpinned.
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_V4L2_MEM2MEM_DEV

# --- The CeraLive RK3588 media island (multi_rga) ---------------------------
# RGA3 core0/core1 and RGA2 now carry sole island compatibles. The driver is a
# tristate whose Kconfig parents, ARCH_ROCKCHIP and ROCKCHIP_IOMMU, are already
# required elsewhere in this closure.
CONFIG_ROCKCHIP_MULTI_RGA=m

# --- dma-buf userland heaps (the MPP allocator) -----------------------------
# DMABUF_HEAPS is a `menuconfig bool` defaulting OFF — the second of the four
# real defects. librockchip_mpp opens /dev/dma_heap/system-uncached BY NAME and
# does not fall back to `system`, so the UNCACHED leaf is as load-bearing as the
# parent. DMA_CMA/CMA are DMABUF_HEAPS_CMA's own dependencies.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_SYSTEM_UNCACHED=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA=y

# --- IOMMU ------------------------------------------------------------------
# IOMMU_SUPPORT is the `menuconfig` parent. The rkvenc encoder maps every
# imported dma-buf through the Rockchip IOMMU; without it the encoder's own
# address guardrail has nothing to translate against.
CONFIG_IOMMU_SUPPORT
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_IOMMU_DMA=y

# --- Thermal and fan --------------------------------------------------------
# THERMAL is the parent. The shipped fan units do not control the fan themselves
# — they move the first `active` trip and kick a stalled rotor, and the kernel's
# step_wise governor does the rest — so THERMAL_GOV_STEP_WISE and the pwm-fan
# hwmon driver are both part of that contract, not optional extras.
CONFIG_THERMAL
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_HWMON
CONFIG_SENSORS_PWM_FAN=m
CONFIG_PWM
CONFIG_PWM_ROCKCHIP=y

# --- Status LEDs ------------------------------------------------------------
# ceralive-led-status assigns `heartbeat` and `mmc1` triggers to the board's
# unclaimed indicator LEDs, which requires both the LED class and those triggers
# to exist; the LEDs themselves are gpio-leds and pwm-leds devices.
CONFIG_NEW_LEDS
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_PWM=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# --- nftables (the LAN-ingest boundary) -------------------------------------
# The fourth real defect, and the only one that was a security regression:
# ceralive-ingest-firewall.service is what keeps the UNAUTHENTICATED RTMP/SRT
# ingest ports off a WAN uplink. NETFILTER_NETLINK is the NETLINK_NETFILTER
# protocol `nft` actually opens — it is promptless and nothing selects it until
# NF_TABLES is on, which is why the board reported a missing netlink protocol
# rather than a missing table.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_IPV6=y

# --- Uplink sharing: steering + shaping (REQ-USB-080..084) -------------------
# The second nftables consumer — ceralive-share.service applies the
# `inet ceralive_share` table CeraUI renders to /run/ceralive/share.nft. These
# are pinned here as well as declared in the fragment because the two manifests
# make DIFFERENT claims: the fragment says what CeraLive ADDS to defconfig, this
# says what the finished kernel must CARRY. A capability defconfig happens to
# supply today can stop being visible tomorrow, and only this claim survives that.
#
# NET_CLS_FW is the `tc filter … fw classid` classifier, and this entry is now
# the ONLY thing that keeps the uplink shaper's mark->band bridge on the image:
# the retired `ceralive-cls-fw` out-of-tree module used to supply it for the
# prebuilt vendor kernel, and this (edge) track — the production track — builds
# it in-tree. Dropping this line ships a device whose shaper silently cannot
# classify. See docs/notes/sharing-kernel-capability.md §2c.
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NUMGEN=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_CLS_FW=y

# --- Storage / rootfs / RAUC ------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=m
CONFIG_OVERLAY_FS=m

# --- Rockchip platform ------------------------------------------------------
# The one platform that must survive the Rockchip-only block in the fragment.
CONFIG_ARCH_ROCKCHIP=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_ROCKCHIP_SARADC=y
